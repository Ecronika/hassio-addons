{
  "name": "Calimero KNXnet/IP Server (RF)",
  "version": "0.18-rf",
  "slug": "calimero_server_rf",
  "description": "KNXnet/IP server in software accessing KNX via FT1.2, TPUART or USB interfaces (media TP1, RF, PL110)",
  "arch": ["aarch64"],
  "url": "https://github.com/Ecronika/hassio-addons/tree/master/calimero-server-rf",
  "init": false,
  "startup": "services",
  "boot": "auto",
  "host_network": true,
  "uart": true,
  "usb": true,
  "options": {
    "knx_address": "1.1.0",
    "client_address_start": "1.1.101",
    "client_address_count": 5,
    "interface_type": "ft12-cemi",
	"routing": true,
    "knx_source_override": true
  },
  "schema": {
    "knx_address": "match(^([0-9]|1[0-5])\\.([0-9]|1[0-5])\\.([0-9]{1,2}|1[0-9]{2}|2[0-4][0-9]|25[0-5])$)",
    "client_address_start": "match(^([0-9]|1[0-5])\\.([0-9]|1[0-5])\\.([0-9]{1,2}|1[0-9]{2}|2[0-4][0-9]|25[0-5])$)",
    "client_address_count": "int(0,255)",
    "interface_type": "list(ft12-cemi|tpuart|usb)",
	"serial_device": "device(subsystem=tty)?",
	"usb_device": "str?",
	"usb_medium": "list(tp1|rf|pl110)?",
	"rf_domain_address": "match(^[0-9A-Fa-f]{2}([:. -]?[0-9A-Fa-f]{2}){1,5}$)?",
	"routing": "bool",
    "knx_source_override": "bool?",
    "loglevel": "list(trace|debug|info|warn|error|off)?",
    "expose_date": "str?",
    "expose_time": "str?",
    "expose_datetime": "str?",
    "timeserver_expiration": "int?"
  }
}
